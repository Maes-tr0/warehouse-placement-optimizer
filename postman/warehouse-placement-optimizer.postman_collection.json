    {
      "name": "05 Structured errors",
      "item": [
        {
          "name": "Missing article returns JSON 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Error contract is RESOURCE_NOT_FOUND', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('RESOURCE_NOT_FOUND');",
                  "  pm.expect(body.path).to.include('/admin/articles/number/');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/articles/number/{{articleNumber}}999"
          }
        },
        {
          "name": "Invalid account returns field errors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Bean validation errors are structured', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.fieldErrors).to.be.an('object');",
                  "  pm.expect(body.fieldErrors).to.have.property('email');",
                  "  pm.expect(body.fieldErrors).to.have.property('password');",
                  "  pm.expect(body.fieldErrors).to.have.property('fullName');",
                  "  pm.expect(body.fieldErrors).to.have.property('role');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123\",\n  \"fullName\": \"\",\n  \"role\": null\n}"
            },
            "url": "{{baseUrl}}/admin/accounts"
          }
        }
      ]
